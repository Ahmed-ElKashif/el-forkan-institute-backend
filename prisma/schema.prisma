  // between preview and commit (report F3b).
  is_historical     Boolean         @default(false)
  storage_path      String
  original_filename String?
  status            job_status_t    @default(pending)
  total_rows        Int?
  ok_rows           Int?
  failed_rows       Int?
  error_report_path String?
