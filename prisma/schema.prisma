// ---------------------------------------------------------------------------
// HAND-EDITED after `prisma db pull` — see backend/agent/memory.md.
// Composite foreign keys make introspection generate relation FIELD names like
// `sections_enrollments_section_idTosections`. The @relation("...") name
// strings are load-bearing and untouched; only the field names a caller types
// were shortened (section, student, enrollments, section_teachers, user).
// The database is unchanged. Re-running `db pull` reverts this — re-apply.
// ---------------------------------------------------------------------------
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model academic_years {
  id                                     Int                   @id @default(autoincrement()) @db.SmallInt
  hijri_year                             Int                   @unique @db.SmallInt
  starts_on                              DateTime              @db.Date
  ends_on                                DateTime              @db.Date
  status                                 period_status_t       @default(planned)
  created_by                             String?               @db.Uuid
  updated_by                             String?               @db.Uuid
  updated_at                             DateTime              @default(now()) @db.Timestamptz(6)
  users_academic_years_created_byTousers users?                @relation("academic_years_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_academic_years_updated_byTousers users?                @relation("academic_years_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance_policies                    attendance_policies[]
  certificates                           certificates[]
  curriculum                             curriculum[]
  import_jobs                            import_jobs[]
  progression_rules                      progression_rules[]
  sections                               sections[]
  terms                                  terms[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String         @db.Uuid
  enrollment_id String         @db.Uuid
  status        attendance_t
  attended_mode attend_mode_t?
  minutes_late  Int?           @db.SmallInt
  note          String?
  recorded_by   String?        @db.Uuid
  recorded_at   DateTime       @default(now()) @db.Timestamptz(6)
  enrollments   enrollments    @relation(fields: [enrollment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?         @relation(fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions      sessions       @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, enrollment_id])
  @@index([enrollment_id, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance_policies {
  id                Int             @id @default(autoincrement())
  academic_year_id  Int             @db.SmallInt
  level_id          Int?            @db.SmallInt
  max_absences      Int             @default(4) @db.SmallInt
  warn_at_absences  Int             @default(3) @db.SmallInt
  auto_warn_enabled Boolean         @default(true)
  exceeding_action  exceed_action_t @default(warn_only)
  updated_by        String?         @db.Uuid
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)
  academic_years    academic_years  @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  levels            levels?         @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?          @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([academic_year_id, level_id])
}

model attendance_warnings {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollment_id String      @db.Uuid
  term_id       Int
  threshold     Int         @db.SmallInt
  absence_count Int         @db.SmallInt
  message_id    BigInt?
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  enrollments   enrollments @relation(fields: [enrollment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages      messages?   @relation(fields: [message_id], references: [id], onUpdate: NoAction, map: "attendance_warnings_message_fk")
  terms         terms       @relation(fields: [term_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([enrollment_id, term_id, threshold])
}

model audit_logs {
  id          BigInt   @id @default(autoincrement())
