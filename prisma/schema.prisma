  users       users?   @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_id, created_at(sort: Desc)])
  @@index([entity_type, entity_id, created_at(sort: Desc)])
}

model books {
