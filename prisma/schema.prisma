/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model certificates {
  id                                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id                           String          @db.Uuid
  level_id                             Int             @db.SmallInt
  enrollment_id                        String?         @db.Uuid
  academic_year_id                     Int?            @db.SmallInt
  branch_id                            Int?            @db.SmallInt
  serial_no                            String?         @unique
  issued_by                            String          @db.Uuid
  issued_at                            DateTime        @default(now()) @db.Timestamptz(6)
  revoked_at                           DateTime?       @db.Timestamptz(6)
  revoked_by                           String?         @db.Uuid
  revoke_reason                        String?
  notes                                String?
  academic_years                       academic_years? @relation(fields: [academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches                             branches?       @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments                          enrollments?    @relation(fields: [enrollment_id], references: [id], onUpdate: NoAction)
  users_certificates_issued_byTousers  users           @relation("certificates_issued_byTousers", fields: [issued_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels                               levels          @relation(fields: [level_id], references: [id], onUpdate: NoAction)
  users_certificates_revoked_byTousers users?          @relation("certificates_revoked_byTousers", fields: [revoked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                             students        @relation(fields: [student_id], references: [id], onUpdate: NoAction)

  // Partial unique index in the DB:
  //   UNIQUE (student_id, level_id) WHERE revoked_at IS NULL
  // i.e. one LIVE certificate per level per student; revoked ones are kept as
  // history and do not block a re-issue. Prisma cannot express a partial
  // unique index, so it is enforced in Postgres only (same tradeoff as the
  // section_teachers primary-teacher index — see agent/memory.md).
  @@index([level_id, issued_at(sort: Desc)])
  @@index([student_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model curriculum {
  id                   Int                @id @default(autoincrement())
  academic_year_id     Int                @db.SmallInt
  level_id             Int                @db.SmallInt
  subject_id           Int
  term_number          Int                @db.SmallInt
  parent_curriculum_id Int?
  is_examinable        Boolean            @default(true)
  is_mandatory         Boolean            @default(false)
  grading_mode         grading_mode_t     @default(score)
  assessment_type      assessment_t       @default(written)
  max_score            Decimal            @default(100) @db.Decimal(6, 2)
  pass_score           Decimal            @default(50) @db.Decimal(6, 2)
  weight               Decimal            @default(1.00) @db.Decimal(5, 2)
  teaching_order       Int?               @db.SmallInt
  updated_by           String?            @db.Uuid
  updated_at           DateTime           @default(now()) @db.Timestamptz(6)
  academic_years       academic_years     @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  levels               levels             @relation(fields: [level_id], references: [id], onUpdate: NoAction)
  curriculum           curriculum?        @relation("curriculumTocurriculum", fields: [parent_curriculum_id, academic_year_id, level_id, term_number], references: [id, academic_year_id, level_id, term_number], onDelete: NoAction, onUpdate: NoAction)
  other_curriculum     curriculum[]       @relation("curriculumTocurriculum")
  subjects             subjects           @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
  users                users?             @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  curriculum_units     curriculum_units[]
  exams                exams[]

  @@unique([academic_year_id, level_id, subject_id, term_number])
  @@unique([id, academic_year_id])
  @@unique([id, academic_year_id, level_id, term_number])
  @@index([academic_year_id, is_mandatory], where: raw("is_mandatory"))
  @@index([academic_year_id, level_id, term_number])
  @@index([parent_curriculum_id])
}

model curriculum_units {
