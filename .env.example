# --- Database (Supabase Postgres) ---
# Both need &sslmode=no-verify (not "require" — newer pg-connection-string
# treats "require" as full CA-chain verification, which fails against
# Supabase's pooler cert; see backend/agent/memory.md "Gotchas" for the
# full diagnosis).
DATABASE_URL=              # pooler, :6543, ?pgbouncer=true&connection_limit=1&sslmode=no-verify
DIRECT_URL=                 # direct, :5432 — used for Prisma migrations, ?sslmode=no-verify

# --- Supabase project ---
SUPABASE_URL=                    # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=        # public key (formerly "anon key")
SUPABASE_SECRET_KEY=             # NEVER sent to the frontend — server-side only (formerly "service_role key")
SUPABASE_JWKS_URL=               # https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Auth ---
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=       # optional extra input mixed into the refresh-token hash
CSRF_SECRET=

# --- App ---
# node runtime mode. Validated at boot; must be development, test or production.
NODE_ENV=development
# Comma-separated allowlist of allowed browser origins. REQUIRED in production —
# the server refuses to start without it there, and never falls back to "*".
# Any origin not listed is rejected (fail closed). e.g.
#   CORS_ORIGIN=https://app.example.org,https://staging.example.org
CORS_ORIGIN=http://localhost:5173
PORT=3000

# Secure flag for the auth cookies. Defaults ON. Set to "false" ONLY for local
# HTTP development, where a Secure cookie would be dropped by the browser. Any
# real (HTTPS) deploy must leave this unset or "true".
COOKIE_SECURE=false

# Cross-site policy for the refresh + CSRF cookies. Leave "strict" for local dev
# and for a deploy where the API and SPA share one registrable domain (e.g.
# api.example.org + app.example.org). Set to "none" ONLY when they are cross-site
# — e.g. two separate *.onrender.com subdomains — or the refresh cookie is
# silently dropped and every token refresh fails. "none" forces Secure (HTTPS).
# See backend/agent/memory.md and the frontend build plan (F0d).
COOKIE_SAMESITE=strict

# AES-256-GCM key for students.national_id_enc (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
